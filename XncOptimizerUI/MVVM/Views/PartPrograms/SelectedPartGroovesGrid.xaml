<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.PartPrograms.SelectedPartGroovesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:XncOptimizerUI.MVVM.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:XncOptimizerUI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Machining"
    d:DataContext="{d:DesignInstance Type=viewmodels:SelectedPartMachiningVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--
        Selected part grooves (<gr>): start / end points, depth and width editable in place
        (click the selected cell or F2), each cell committed on its own through GrooveRowVM
    -->
    <DataGrid
        x:Name="GroovesDataGrid"
        helpers:DataGridCellEditBehavior.CommitToRow="True"
        ItemsSource="{Binding Grooves}"
        SelectedItem="{Binding SelectedGroove}"
        Style="{StaticResource OperationGridStyle}">
        <DataGrid.Columns>

            <!--  Read-only groove identity  -->
            <DataGridTextColumn
                x:Name="GroovesNumberColumn"
                Width="Auto"
                Binding="{Binding Number}"
                Header="#"
                IsReadOnly="True" />
            <DataGridTextColumn
                x:Name="GroovesSideColumn"
                Width="Auto"
                Binding="{Binding Side}"
                Header="Side"
                IsReadOnly="True" />

            <!--  Start and end points: edit the authored x1 / y1 / x2 / y2  -->
            <common:ExpressionColumn
                x:Name="GroovesStartXColumn"
                Cell="StartX"
                Header="Start X" />
            <common:ExpressionColumn
                x:Name="GroovesStartYColumn"
                Cell="StartY"
                Header="Start Y" />
            <common:ExpressionColumn
                x:Name="GroovesEndXColumn"
                Cell="EndX"
                Header="End X" />
            <common:ExpressionColumn
                x:Name="GroovesEndYColumn"
                Cell="EndY"
                Header="End Y" />

            <!--  Cut: depth and width (edit dp / t), tool to center line position (read-only)  -->
            <common:ExpressionColumn
                x:Name="GroovesDepthColumn"
                Cell="Depth"
                Header="Depth" />
            <common:ExpressionColumn
                x:Name="GroovesWidthColumn"
                Cell="Width"
                Header="Width" />
            <DataGridTextColumn
                x:Name="GroovesTclColumn"
                Width="*"
                Binding="{Binding ToolToCenterLine}"
                Header="TCL"
                IsReadOnly="True" />

        </DataGrid.Columns>
    </DataGrid>
</UserControl>
