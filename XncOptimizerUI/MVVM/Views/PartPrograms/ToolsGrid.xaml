<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.PartPrograms.ToolsGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Machining"
    d:DataContext="{d:DesignInstance Type=viewmodels:SelectedPartMachiningVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--  Selected part tool declarations (<tool>), read-only  -->
    <DataGrid
        x:Name="ToolsDataGrid"
        IsReadOnly="True"
        ItemsSource="{Binding Tools}"
        Style="{StaticResource ProgramGridStyle}">
        <DataGrid.Columns>
            <DataGridTextColumn
                x:Name="ToolsNumberColumn"
                Binding="{Binding Number}"
                Header="#" />
            <DataGridTextColumn
                x:Name="ToolsSideColumn"
                Binding="{Binding Side}"
                Header="Side" />
            <DataGridTextColumn
                x:Name="ToolsNameColumn"
                Binding="{Binding Name}"
                Header="Tool" />
            <DataGridTextColumn
                x:Name="ToolsDiameterColumn"
                Binding="{Binding Diameter}"
                Header="Ø" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
