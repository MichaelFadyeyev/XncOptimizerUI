<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.PartPrograms.MillingRectanglesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:XncOptimizerUI.MVVM.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:XncOptimizerUI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Machining"
    d:DataContext="{d:DesignInstance Type=viewmodels:SelectedPartMachiningVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--
        Selected part milling rectangles (<mr>): center, depth, size, angle and corner radius
        editable in place (click the selected cell or F2), each cell committed on its own
    -->
    <DataGrid
        x:Name="MillingRectanglesDataGrid"
        helpers:DataGridCellEditBehavior.CommitToRow="True"
        ItemsSource="{Binding MillingRectangles}"
        SelectedItem="{Binding SelectedMillingRectangle}"
        Style="{StaticResource OperationGridStyle}">
        <DataGrid.Columns>

            <!--  Read-only rectangle identity  -->
            <DataGridTextColumn
                x:Name="RectanglesNumberColumn"
                Width="Auto"
                Binding="{Binding Number}"
                Header="#"
                IsReadOnly="True" />
            <DataGridTextColumn
                x:Name="RectanglesSideColumn"
                Width="Auto"
                Binding="{Binding Side}"
                Header="Side"
                IsReadOnly="True" />

            <!--  Center: edits the authored x / y  -->
            <common:ExpressionColumn
                x:Name="RectanglesCenterXColumn"
                Cell="CenterX"
                Header="Center X" />
            <common:ExpressionColumn
                x:Name="RectanglesCenterYColumn"
                Cell="CenterY"
                Header="Center Y" />

            <!--  Cut: depth, size, angle (edit dp / l / w / a), tool to center line position (read-only), corner radius (edits r)  -->
            <common:ExpressionColumn
                x:Name="RectanglesDepthColumn"
                Cell="Depth"
                Header="Depth" />
            <common:ExpressionColumn
                x:Name="RectanglesLengthColumn"
                Cell="Length"
                Header="Length" />
            <common:ExpressionColumn
                x:Name="RectanglesWidthColumn"
                Cell="Width"
                Header="Width" />
            <common:ExpressionColumn
                x:Name="RectanglesAngleColumn"
                Cell="Angle"
                Header="Angle°" />
            <DataGridTextColumn
                x:Name="RectanglesTclColumn"
                Width="*"
                Binding="{Binding ToolToCenterLine}"
                Header="TCL"
                IsReadOnly="True" />
            <common:ExpressionColumn
                x:Name="RectanglesCornerRadiusColumn"
                Cell="CornerRadius"
                Header="Corn.R" />

        </DataGrid.Columns>
    </DataGrid>
</UserControl>
