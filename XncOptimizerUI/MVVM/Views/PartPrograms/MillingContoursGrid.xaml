<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.PartPrograms.MillingContoursGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:XncOptimizerUI.MVVM.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Machining"
    d:DataContext="{d:DesignInstance Type=viewmodels:SelectedPartMachiningVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--  Selected part milling contours (<ms> paths), read-only  -->
    <DataGrid
        x:Name="MillingContoursDataGrid"
        ItemsSource="{Binding MillingContours}"
        Style="{StaticResource ReadOnlyOperationGridStyle}">
        <DataGrid.Columns>

            <!--  Check: feeds SelectedPartMachiningVM's checked contours  -->
            <common:RowCheckColumn x:Name="ContoursCheckColumn" />

            <!--  Contour identity  -->
            <DataGridTextColumn
                x:Name="ContoursNumberColumn"
                Width="Auto"
                Binding="{Binding Number}"
                Header="#" />
            <DataGridTextColumn
                x:Name="ContoursSideColumn"
                Width="Auto"
                Binding="{Binding Side}"
                Header="Side" />

            <!--  Entry and exit points  -->
            <DataGridTextColumn
                x:Name="ContoursEntryXColumn"
                Width="*"
                Binding="{Binding EntryX}"
                Header="Entry X" />
            <DataGridTextColumn
                x:Name="ContoursEntryYColumn"
                Width="*"
                Binding="{Binding EntryY}"
                Header="Entry Y" />
            <DataGridTextColumn
                x:Name="ContoursExitXColumn"
                Width="*"
                Binding="{Binding ExitX}"
                Header="Exit X" />
            <DataGridTextColumn
                x:Name="ContoursExitYColumn"
                Width="*"
                Binding="{Binding ExitY}"
                Header="Exit Y" />

            <!--  Cut: depth, tool to center line position, segment count  -->
            <DataGridTextColumn
                x:Name="ContoursDepthColumn"
                Width="*"
                Binding="{Binding Depth}"
                Header="Depth" />
            <DataGridTextColumn
                x:Name="ContoursTclColumn"
                Width="*"
                Binding="{Binding ToolToCenterLine}"
                Header="TCL" />
            <DataGridTextColumn
                x:Name="ContoursSegmentsColumn"
                Width="*"
                Binding="{Binding Segments}"
                Header="Segments" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
