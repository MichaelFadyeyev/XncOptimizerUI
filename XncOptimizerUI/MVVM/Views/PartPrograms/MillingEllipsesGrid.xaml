<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.PartPrograms.MillingEllipsesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:XncOptimizerUI.MVVM.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:XncOptimizerUI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Machining"
    d:DataContext="{d:DesignInstance Type=viewmodels:SelectedPartMachiningVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--
        Selected part milling ellipses (<me>): center, depth, semi-axes and angle editable in
        place (click the selected cell or F2), each cell committed on its own
    -->
    <DataGrid
        x:Name="MillingEllipsesDataGrid"
        helpers:DataGridCellEditBehavior.CommitToRow="True"
        ItemsSource="{Binding MillingEllipses}"
        SelectedItem="{Binding SelectedMillingEllipse}"
        Style="{StaticResource OperationGridStyle}">
        <DataGrid.Columns>

            <!--  Read-only ellipse identity  -->
            <DataGridTextColumn
                x:Name="EllipsesNumberColumn"
                Width="Auto"
                Binding="{Binding Number}"
                Header="#"
                IsReadOnly="True" />
            <DataGridTextColumn
                x:Name="EllipsesSideColumn"
                Width="Auto"
                Binding="{Binding Side}"
                Header="Side"
                IsReadOnly="True" />

            <!--  Center: edits the authored x / y  -->
            <common:ExpressionColumn
                x:Name="EllipsesCenterXColumn"
                Cell="CenterX"
                Header="Center X" />
            <common:ExpressionColumn
                x:Name="EllipsesCenterYColumn"
                Cell="CenterY"
                Header="Center Y" />

            <!--  Cut: depth, semi-axes, angle (edit dp / l / w / a), tool to center line position (read-only)  -->
            <common:ExpressionColumn
                x:Name="EllipsesDepthColumn"
                Cell="Depth"
                Header="Depth" />
            <common:ExpressionColumn
                x:Name="EllipsesLengthColumn"
                Cell="Length"
                Header="Length R" />
            <common:ExpressionColumn
                x:Name="EllipsesWidthColumn"
                Cell="Width"
                Header="Width R" />
            <common:ExpressionColumn
                x:Name="EllipsesAngleColumn"
                Cell="Angle"
                Header="Angle°" />
            <DataGridTextColumn
                x:Name="EllipsesTclColumn"
                Width="*"
                Binding="{Binding ToolToCenterLine}"
                Header="TCL"
                IsReadOnly="True" />

        </DataGrid.Columns>
    </DataGrid>
</UserControl>
