<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.PartPrograms.SelectedPartBoresGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:XncOptimizerUI.MVVM.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:XncOptimizerUI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Machining"
    d:DataContext="{d:DesignInstance Type=viewmodels:SelectedPartMachiningVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--
        Selected part bores: X / Y / Depth editable in place (click the selected cell or F2),
        each cell committed on its own through BoreRowVM (ICellEditableRow)
    -->
    <DataGrid
        x:Name="BoresDataGrid"
        helpers:DataGridCellEditBehavior.CommitToRow="True"
        ItemsSource="{Binding Bores}"
        SelectedItem="{Binding SelectedBore}"
        Style="{StaticResource OperationGridStyle}">
        <DataGrid.Columns>

            <!--  Check: feeds SelectedPartMachiningVM.CheckedBores  -->
            <common:RowCheckColumn x:Name="BoresCheckColumn" />

            <!--  Read-only bore identity  -->
            <DataGridTextColumn
                x:Name="BoresNumberColumn"
                Width="Auto"
                Binding="{Binding Number}"
                Header="#"
                IsReadOnly="True" />
            <DataGridTextColumn
                x:Name="BoresSideColumn"
                Width="Auto"
                Binding="{Binding Side}"
                Header="Side"
                IsReadOnly="True" />

            <!--  Position: edits the authored x / y (z for the coordinate across an edge bore's thickness)  -->
            <common:ExpressionColumn
                x:Name="BoresXColumn"
                Cell="X"
                Header="X" />
            <common:ExpressionColumn
                x:Name="BoresYColumn"
                Cell="Y"
                Header="Y" />

            <!--  Diameter: from the bore's tool, read-only  -->
            <DataGridTextColumn
                x:Name="BoresDiameterColumn"
                Width="*"
                Binding="{Binding Diameter}"
                Header="Ø"
                IsReadOnly="True" />

            <!--  Depth: edits the authored dp  -->
            <common:ExpressionColumn
                x:Name="BoresDepthColumn"
                Cell="Depth"
                Header="Depth" />

        </DataGrid.Columns>
    </DataGrid>
</UserControl>
