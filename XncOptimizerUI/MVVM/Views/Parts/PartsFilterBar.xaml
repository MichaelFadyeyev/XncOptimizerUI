<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.Parts.PartsFilterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:validators="clr-namespace:XncOptimizerUI.MVVM.Validators"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--
        Parts filter: checked / filtered counts on the first row; check buttons, length and
        width ranges, name filter and Filter / Clear buttons on the second
    -->
    <Grid x:Name="PartsFilterGrid" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="0.22*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0.22*" />
            <ColumnDefinition Width="0.22*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0.22*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Checked parts count (across the whole project)  -->
        <StackPanel
            x:Name="CheckedCountPanel"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="11"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <Label
                x:Name="CheckedCountCaption"
                VerticalAlignment="Center"
                Content="Checked no:" />
            <Label
                x:Name="CheckedCountLabel"
                VerticalAlignment="Center"
                Content="{Binding PartsList.CheckedCount}" />
        </StackPanel>

        <!--  Filtered parts count  -->
        <StackPanel
            x:Name="FilteredCountPanel"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="11"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Label
                x:Name="FilteredCountCaption"
                VerticalAlignment="Center"
                Content="Filtered no:" />
            <Label
                x:Name="FilteredCountLabel"
                VerticalAlignment="Center"
                Content="{Binding PartsList.Parts.Count}" />
        </StackPanel>

        <Button
            x:Name="CheckAllButton"
            Grid.Row="1"
            Grid.Column="0"
            Command="{Binding PartsList.CheckAllCommand}"
            Content="Check all"
            Style="{StaticResource CompactButtonStyle}" />

        <Button
            x:Name="UncheckAllButton"
            Grid.Row="1"
            Grid.Column="1"
            Command="{Binding PartsList.UncheckAllCommand}"
            Content="Uncheck all"
            Style="{StaticResource CompactButtonStyle}" />

        <!--  Length range  -->
        <TextBox
            x:Name="LengthMinTextBox"
            Grid.Row="1"
            Grid.Column="2"
            Style="{StaticResource DecimalRangeTextBoxStyle}"
            Text="{validators:DecimalBinding Filter.LengthMin}"
            ToolTip="Length min" />

        <TextBlock
            x:Name="LengthRangeDash"
            Grid.Row="1"
            Grid.Column="3"
            Margin="2,0,0,0"
            VerticalAlignment="Center"
            Text="&#8211;" />

        <TextBox
            x:Name="LengthMaxTextBox"
            Grid.Row="1"
            Grid.Column="4"
            Style="{StaticResource DecimalRangeTextBoxStyle}"
            Text="{validators:DecimalBinding Filter.LengthMax}"
            ToolTip="Length max" />

        <!--  Width range  -->
        <TextBox
            x:Name="WidthMinTextBox"
            Grid.Row="1"
            Grid.Column="5"
            Style="{StaticResource DecimalRangeTextBoxStyle}"
            Text="{validators:DecimalBinding Filter.WidthMin}"
            ToolTip="Width min" />

        <TextBlock
            x:Name="WidthRangeDash"
            Grid.Row="1"
            Grid.Column="6"
            Margin="2,0,0,0"
            VerticalAlignment="Center"
            Text="&#8211;" />

        <TextBox
            x:Name="WidthMaxTextBox"
            Grid.Row="1"
            Grid.Column="7"
            Style="{StaticResource DecimalRangeTextBoxStyle}"
            Text="{validators:DecimalBinding Filter.WidthMax}"
            ToolTip="Width max" />

        <!--  Name filter  -->
        <TextBox
            x:Name="FilterNameTextBox"
            Grid.Row="1"
            Grid.Column="8"
            Style="{StaticResource CompactTextBoxStyle}"
            Text="{Binding Filter.FilterName}"
            ToolTip="Name contains" />

        <Button
            x:Name="ApplyFilterButton"
            Grid.Row="1"
            Grid.Column="9"
            Command="{Binding Filter.ApplyFilterCommand}"
            Content="Filter"
            Style="{StaticResource CompactButtonStyle}" />

        <Button
            x:Name="ClearFiltersButton"
            Grid.Row="1"
            Grid.Column="10"
            Command="{Binding Filter.ClearFiltersCommand}"
            Content="Clear"
            Style="{StaticResource CompactButtonStyle}" />
    </Grid>
</UserControl>
