<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.Menu.ConvertBoresMillsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Panels"
    xmlns:xnc="clr-namespace:XncOptimizerUI.MVVM.Models.Xnc"
    d:DataContext="{d:DesignInstance Type=viewmodels:BoreMillPanelVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--  Convert bores and mills: command, direction and ellipse option  -->
    <Border x:Name="ConvertBoresMillsBorder" Style="{StaticResource MenuGroupBorderStyle}">
        <StackPanel x:Name="ConvertBoresMillsStack">
            <Button
                x:Name="ConvertBoresMillsButton"
                Command="{Binding ConvertBoresAndMillsCommand}"
                Content="Convert bores / mills"
                Style="{StaticResource CommandButtonStyle}" />

            <!--  Direction radios; ellipses only apply to bores to mills  -->
            <Grid x:Name="BoreMillOptionsGrid" Margin="0,7,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton
                    x:Name="BoresToMillsRadio"
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="Bores → Mills"
                    GroupName="BoreMillDir"
                    IsChecked="{Binding BoreMillDirection, ConverterParameter={x:Static xnc:BoreMillDirection.BoresToMills}, Converter={StaticResource EnumToBool}}"
                    Style="{StaticResource MenuRadioButtonStyle}" />

                <CheckBox
                    x:Name="ConvertBoresToEllipsesCheckBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="as ellipses"
                    IsChecked="{Binding ConvertBoresToEllipses}"
                    IsEnabled="{Binding BoreMillDirection, ConverterParameter={x:Static xnc:BoreMillDirection.BoresToMills}, Converter={StaticResource EnumToBool}}"
                    Style="{StaticResource MenuCheckBoxStyle}"
                    ToolTip="Bores → Mills: emit an elliptical mill (&lt;me&gt;) per bore instead of a closed four-arc path" />

                <RadioButton
                    x:Name="MillsToBoresRadio"
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="Mills → Bores"
                    GroupName="BoreMillDir"
                    IsChecked="{Binding BoreMillDirection, ConverterParameter={x:Static xnc:BoreMillDirection.MillsToBores}, Converter={StaticResource EnumToBool}}"
                    Style="{StaticResource MenuRadioButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
