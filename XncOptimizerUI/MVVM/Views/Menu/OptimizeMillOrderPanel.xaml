<UserControl
    x:Class="XncOptimizerUI.MVVM.Views.Menu.OptimizeMillOrderPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels.Panels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MillOrderPanelVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--  Optimize mill traversal: reorders mills to shorten the tool's travel  -->
    <StackPanel x:Name="OptimizeMillOrderStack" Style="{StaticResource MenuCommandPanelStyle}">
        <Button
            x:Name="OptimizeMillOrderButton"
            Command="{Binding OptimizeMillTraversalCommand}"
            Content="Optimize mill order"
            Style="{StaticResource CommandButtonStyle}" />
    </StackPanel>
</UserControl>
