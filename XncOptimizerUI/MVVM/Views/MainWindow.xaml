<Window x:Class="XncOptimizerUI.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XncOptimizerUI"
        xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel}"
        mc:Ignorable="d"
        Title="XncOptimizer" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel  Grid.Column="0">
            <Button Height="50"
                    Content="Open file" 
                    Command="{Binding OpenFile}"/>
            <Button Height="50" 
                    Content="Optimize" 
                    Command="{Binding ExecuteOperation}"/>
        </StackPanel>
        <TextBox Grid.Column="1" 
                 Text="{Binding Log, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="WrapWithOverflow"/>
    </Grid>
</Window>
