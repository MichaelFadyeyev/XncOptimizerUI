<Window
    x:Class="XncOptimizerUI.MVVM.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materials="clr-namespace:XncOptimizerUI.MVVM.Views.Materials"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="clr-namespace:XncOptimizerUI.MVVM.Views.Menu"
    xmlns:partPreview="clr-namespace:XncOptimizerUI.MVVM.Views.PartPreview"
    xmlns:partPrograms="clr-namespace:XncOptimizerUI.MVVM.Views.PartPrograms"
    xmlns:parts="clr-namespace:XncOptimizerUI.MVVM.Views.Parts"
    xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1024"
    Height="1200"
    d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!--  Main grid: menu bar on the left; project tabs over the log on the right  -->
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0.5*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Menu bar: file operations, options and the batch commands with their options  -->
        <StackPanel
            x:Name="MenuBar"
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Style="{StaticResource MenuBarStyle}">

            <menu:FileOperationsPanel x:Name="FileOperationsPanel" />

            <menu:OptionsPanel x:Name="OptionsPanel" DataContext="{Binding Preview}" />

            <!--  Copy parts: the parts list to the clipboard  -->
            <StackPanel x:Name="CopyPartsPanel" Style="{StaticResource MenuCommandPanelStyle}">
                <Button
                    x:Name="CopyPartsButton"
                    Command="{Binding CopyPartsListCommand}"
                    Content="Copy parts"
                    Style="{StaticResource CommandButtonStyle}" />
            </StackPanel>

            <menu:PreparationPanel x:Name="PreparationPanel" DataContext="{Binding Preparation}" />

            <menu:CleanOperationsPanel x:Name="CleanOperationsPanel" DataContext="{Binding CleanOutside}" />

            <menu:SortToolsPanel x:Name="SortToolsPanel" DataContext="{Binding SortTools}" />

            <menu:ReplaceXncPanel x:Name="ReplaceXncPanel" DataContext="{Binding SourcePart}" />

            <menu:ConvertGroovesMillsPanel x:Name="ConvertGroovesMillsPanel" DataContext="{Binding GrooveMill}" />

            <menu:ConvertBoresMillsPanel x:Name="ConvertBoresMillsPanel" DataContext="{Binding BoreMill}" />

            <menu:OffsetMillPathsPanel x:Name="OffsetMillPathsPanel" DataContext="{Binding MillOffset}" />

            <menu:OptimizeMillOrderPanel x:Name="OptimizeMillOrderPanel" DataContext="{Binding MillOrder}" />
        </StackPanel>

        <!--  Project tabs: parts, products and materials  -->
        <TabControl
            x:Name="ProjectTabs"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1">

            <!--  Parts: filtered parts list over the selected part's preview and programs  -->
            <TabItem
                x:Name="PartsTab"
                Width="130"
                Header="Parts">
                <Grid x:Name="PartsTabGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.6*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="0.4*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!--  Parts filter above the parts list  -->
                    <DockPanel x:Name="PartsListPanel" Grid.Row="0">
                        <parts:PartsFilterBar x:Name="PartsFilterBar" DockPanel.Dock="Top" />

                        <parts:PartsGrid x:Name="PartsGrid" />
                    </DockPanel>

                    <GridSplitter
                        x:Name="PartsSplitter"
                        Grid.Row="1"
                        Style="{StaticResource RowSplitterStyle}" />

                    <!--  Selected part: preview and programs  -->
                    <Grid
                        x:Name="SelectedPartContainer"
                        Grid.Row="2"
                        Margin="5,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="420" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <!--  Preview area: part preview and fixed-width rotation buttons column  -->
                        <Grid x:Name="PartPreviewArea" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource PartRotationColumnWidth}" />
                            </Grid.ColumnDefinitions>

                            <!--  Preview: zoomable part drawing  -->
                            <partPreview:PartPreviewControl
                                x:Name="PartPreview"
                                Grid.Column="0"
                                DataContext="{Binding Preview}" />

                            <!--  Part rotation: 0° / 90° / 180° / 270° buttons stacked vertically  -->
                            <partPreview:PartRotationPanel
                                x:Name="PartRotationPanel"
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                VerticalAlignment="Top"
                                DataContext="{Binding Preview}" />
                        </Grid>

                        <GridSplitter
                            x:Name="SelectedPartSplitter"
                            Grid.Column="1"
                            Style="{StaticResource ColumnSplitterStyle}" />

                        <partPrograms:SelectedPartProgramsTabs
                            x:Name="SelectedPartProgramsTabs"
                            Grid.Column="2"
                            DataContext="{Binding Machining}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!--  Products and materials of the project  -->
            <TabItem
                x:Name="ProductsMaterialsTab"
                Width="130"
                Header="Products &amp; Materials">
                <materials:ProductsMaterialsTab x:Name="ProductsMaterials" DataContext="{Binding Catalog}" />
            </TabItem>
        </TabControl>

        <!--  Log  -->
        <TextBox
            x:Name="LogTextBox"
            Grid.Row="3"
            Grid.Column="1"
            Height="60"
            Text="{Binding Log.Text, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="WrapWithOverflow"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
