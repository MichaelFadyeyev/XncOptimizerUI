<Window x:Class="XncOptimizerUI.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XncOptimizerUI"
        xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels"
        xmlns:validators="clr-namespace:XncOptimizerUI.MVVM.Validators"
        d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel}"
        mc:Ignorable="d"
        Title="{Binding WindowTile}" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="TextWrappingStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style x:Key="SetOptionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style x:Key="FilterInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2, 0, 0, 0"/>
            <Setter Property="Padding" Value="0, 2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel  Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
            <StackPanel DockPanel.Dock="Top">
                <Button Style="{StaticResource CommandButtonStyle}"
                    Content="Open file" 
                    Command="{Binding OpenFileCommand}"/>
                <Button Style="{StaticResource CommandButtonStyle}" 
                    Content="Optimize" 
                    Command="{Binding ExecuteOptimizeCommand}"/>
                <Button Style="{StaticResource CommandButtonStyle}" 
                    Content="Prep. For Split Along X" 
                    Command="{Binding ExecutePrepForSplitAlongXCommand}"/>
                <Button Style="{StaticResource CommandButtonStyle}" 
                    Content="Prep. For Split Along X 2" 
                    Command="{Binding ExecutePrepForSplitAlongXCommand3}"/>
                <Label Content="Add new label:" HorizontalAlignment="Left" Margin="5, 2, 0, 0" Padding="0" FontSize="10"/>
                <Grid HorizontalAlignment="Stretch" Margin="5, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Height="24"
                             Text="{Binding NewLabelToProcess, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" 
                            Style="{StaticResource SetOptionButtonStyle}"
                            Content="ADD"
                            Command="{Binding AddNewLabelCommand}"/>
                </Grid>
                <Label Content="Select label to process:" HorizontalAlignment="Left" Margin="5, 2, 0, 0" Padding="0" FontSize="10"/>
                <Grid HorizontalAlignment="Stretch" Margin="5, 0, 5, 5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Height="24"
                          ItemsSource="{Binding LabelsToProcess}"
                          SelectedItem="{Binding SelectedLabel}"/>
                    <Button Grid.Column="1" 
                            Style="{StaticResource SetOptionButtonStyle}"
                            Content="DEL"
                            Command="{Binding DeleteLabelCommand}"/>
                </Grid>
                <Button Style="{StaticResource CommandButtonStyle}" 
                    Content="Read parts" 
                    Command="{Binding ReadPartsCommand}"/>
                <Button Style="{StaticResource CommandButtonStyle}" 
                    Content="Copy parts" 
                    Command="{Binding CopyPartsListCommand}"/>
                <Button Style="{StaticResource CommandButtonStyle}" 
                    Content="Save file" 
                    Command="{Binding SaveFileCommand}"/>
                <Button Style="{StaticResource CommandButtonStyle}"
                        Content="CloseFile"
                        Command="{Binding CloseFileCommand}"/>
            </StackPanel>
        </DockPanel>
        <DataGrid Grid.Column="1" 
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Bands}"
                  SelectedItem="{Binding SelectedBand}" 
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Right"
                  Height="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ext. Sign" Binding="{Binding ExternalSymbol}" 
                                    Width="5*">
                    <!--<DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>-->
                </DataGridTextColumn>
                <DataGridTextColumn Header="Int. Sign" Binding="{Binding InternalSymbol}" 
                                    Width="5*">
                    <!--<DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>-->
                </DataGridTextColumn>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="20*"/>
                <DataGridTextColumn Header="Vame" Binding="{Binding Name}" Width="70*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid DockPanel.Dock="Top" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Column="0"
                    Style="{StaticResource FilterInputStyle}"
                    Text="{Binding FilterLength}">
                    <!--<TextBox.Text>
                        <Binding Path="FilterLength"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnDataErrors="True"
                                 NotifyOnValidationError="True"
                                 Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validators:DecimalValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>-->
                </TextBox>
                <TextBox Grid.Column="1"
                    Style="{StaticResource FilterInputStyle}"
                    Text="{Binding FilterWidth}">
                    <!--<TextBox.Text>
                        <Binding Path="FilterWidth"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnDataErrors="True"
                                 NotifyOnValidationError="True"
                                 Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validators:DecimalValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>-->
                </TextBox>
                <TextBox Grid.Column="2"
                            Style="{StaticResource FilterInputStyle}"
                            Text="{Binding FilterName}">
                </TextBox>
                <Button Grid.Column="3"
                        Height="20" 
                        Margin="2, 0, 0, 0" 
                        Padding="0, 2"
                        Content="Filter"
                        Command="{Binding ApplyFilterCommand}"/>
                <Button Grid.Column="4"
                        Height="20" 
                        Margin="2, 0, 0, 0" 
                        Padding="0, 2"
                        Content="Clear"
                        Command="{Binding ClearFiltersCommand}"/>
                <StackPanel Grid.Column="5" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Label Content="Filtered count:" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Label Content="{Binding Parts.Count}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <DataGrid 
                    AutoGenerateColumns="False" 
                    ItemsSource="{Binding Parts, UpdateSourceTrigger=PropertyChanged}" 
                    SelectedItem="{Binding SelectedPart}" 
                    CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No" Binding="{Binding Number}" Width="2*" />
                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="5*"/>
                    <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="5*"/>
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="5*"/>
                    <DataGridTextColumn Header="Top Band" Binding="{Binding TopBandingMat}" Width="15*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextWrappingStyle}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Bottom Band" Binding="{Binding BottomBandingMat}" Width="15*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextWrappingStyle}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Left band" Binding="{Binding LeftBandingMat}" Width="15*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextWrappingStyle}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Right Band" Binding="{Binding RightBandingMat}" Width="15*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextWrappingStyle}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="22*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="60" 
                 Text="{Binding Log, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="WrapWithOverflow"/>
    </Grid>
</Window>
