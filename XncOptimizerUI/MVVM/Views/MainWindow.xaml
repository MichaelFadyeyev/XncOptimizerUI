<Window x:Class="XncOptimizerUI.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XncOptimizerUI"
        xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel}"
        mc:Ignorable="d"
        Title="XncOptimizer" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel  Grid.Column="0">
            <Button Height="50"
                    Content="Open file" 
                    Command="{Binding OpenFile}"/>
            <Button Height="50" 
                    Content="Optimize" 
                    Command="{Binding ExecuteOptimize}"/>
            <Button Height="50" 
                    Content="Prep. For Split Along X" 
                    Command="{Binding ExecutePrepForSplitAlongX}"/>
            <Button Height="50" 
                    Content="Read parts" 
                    Command="{Binding ReadParts}"/>
        </StackPanel>
        <StackPanel  Grid.Column="1">
            <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Parts}" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="*"/>
                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox 
                 Text="{Binding Log, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="WrapWithOverflow"/>
        </StackPanel>
    </Grid>
</Window>
