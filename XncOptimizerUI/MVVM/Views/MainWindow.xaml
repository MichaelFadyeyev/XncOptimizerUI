<Window x:Class="XncOptimizerUI.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XncOptimizerUI"
        xmlns:viewmodels="clr-namespace:XncOptimizerUI.MVVM.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel}"
        mc:Ignorable="d"
        Title="XncOptimizer" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel  Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
            <StackPanel DockPanel.Dock="Top">
                <Button Height="50"
                    Content="Open file" 
                    Command="{Binding OpenFile}"/>
                <Button Height="50" 
                    Content="Optimize" 
                    Command="{Binding ExecuteOptimize}"/>
                <Button Height="50" 
                    Content="Prep. For Split Along X" 
                    Command="{Binding ExecutePrepForSplitAlongX}"/>
                <Button Height="50" 
                    Content="Read parts" 
                    Command="{Binding ReadParts}"/>
            </StackPanel>
        </DockPanel>
        <ListBox Grid.Column="1" x:Name="BandsList"
                         ItemsSource="{Binding Bands}"
                         SelectedItem="{Binding SelectedBand}" 
                         HorizontalContentAlignment="Left"
                         Margin="20"
                 Height="125">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel HorizontalAlignment="Left">
                        <TextBlock Text="{Binding InternalSymbol}"/>
                        <TextBlock Text=" | "/>
                        <TextBlock Text="{Binding Name}"/>
                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DataGrid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                AutoGenerateColumns="False" 
                      ItemsSource="{Binding Parts, UpdateSourceTrigger=PropertyChanged}" 
                      CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding Number}" Width="50" />
                <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="75"/>
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="75"/>
                <DataGridTextColumn Header="Top Band" Binding="{Binding TopBandingId}" Width="100"/>
                <DataGridTextColumn Header="Bottom Band" Binding="{Binding BottomBandingId}" Width="100"/>
                <DataGridTextColumn Header="Left band" Binding="{Binding LeftBandingId}" Width="100"/>
                <DataGridTextColumn Header="Right Band" Binding="{Binding RightmBandingId}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="60" 
                 Text="{Binding Log, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="WrapWithOverflow"/>
    </Grid>
</Window>
