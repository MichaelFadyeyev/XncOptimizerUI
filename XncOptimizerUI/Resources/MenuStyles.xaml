<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Menu bar column holding the menu panels  -->
    <Style x:Key="MenuBarStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="5" />
    </Style>

    <!--  Framed group of one menu command and its options  -->
    <Style x:Key="MenuGroupBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="2,2,2,12" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--  Unframed menu command without options  -->
    <Style x:Key="MenuCommandPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  File operations button (Open, Close, Save, ...)  -->
    <Style x:Key="FileOpsButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!--  Menu command button  -->
    <Style x:Key="CommandButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30" />
    </Style>

    <!--  Narrow button right of an option input (ADD, DEL)  -->
    <Style x:Key="InlineOptionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  Option button filling its grid cell (SET, RESET)  -->
    <Style x:Key="CellOptionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="1,0" />
    </Style>

    <!--  Small caption above a menu option  -->
    <Style x:Key="MenuCaptionLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!--  Small menu option check box  -->
    <Style x:Key="MenuCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!--  Small menu option radio button  -->
    <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!--  Menu text that wraps in the narrow menu column  -->
    <Style x:Key="TextWrappingStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
